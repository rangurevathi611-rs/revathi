PORT=4000
# Either name works. Use the Atlas string on Render.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/trustvault?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/trustvault
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
# 32 bytes, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-base64-32-byte-key
CLIENT_ORIGIN=http://localhost:5173
